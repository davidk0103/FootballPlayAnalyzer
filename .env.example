# Copy to .env (repo root for Docker Compose, backend/.env for local uvicorn/CLI).
# Every value below has a working default; nothing is secret in Milestone 1.

# --- Docker Compose database ---
POSTGRES_USER=playbookiq
POSTGRES_PASSWORD=playbookiq
POSTGRES_DB=playbookiq
# Host port for the compose db (5433 avoids clashing with a local Postgres on 5432).
POSTGRES_HOST_PORT=5433

# --- Backend (pydantic-settings, case-insensitive) ---
# Local (non-Docker) runs: point at the compose db on 5433 or your own Postgres.
DATABASE_URL=postgresql+psycopg://playbookiq:playbookiq@localhost:5433/playbookiq
# Integration tests (make test-db starts this on 5434).
TEST_DATABASE_URL=postgresql+psycopg://playbookiq:playbookiq@localhost:5434/playbookiq_test
# Where downloaded nflverse parquet files are cached.
DATA_CACHE_DIR=data/cache
NFLVERSE_PBP_BASE_URL=https://github.com/nflverse/nflverse-data/releases/download/pbp
NFLVERSE_PLAYERS_URL=https://github.com/nflverse/nflverse-data/releases/download/players/players.parquet
CORS_ORIGINS=["http://localhost:5317","http://127.0.0.1:5317"]
INGEST_CHUNK_SIZE=5000
# Samples smaller than this add a warning to analytics responses.
MIN_SAMPLE_WARNING=30

# --- Frontend (Vite) ---
# Leave empty to use the dev-server proxy (/api -> VITE_API_PROXY_TARGET).
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8317
